# Production env — copy to .env, never commit real values
# No secrets are required for the static build; this file documents allowed vars
CRICKET_ENV=production
CRICKET_VERSION=1.0.0
CRICKET_CDN_ORIGIN=https://cdn.example.com
# Feature flags (see config/feature-flags.json)
# Enable 3D by default, 2D as fallback
FEATURE_3D=true
FEATURE_BOT_AI=true
